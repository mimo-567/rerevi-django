[Unit]
Description=Delete expired RE Revi shared answers
[Service]
Type=oneshot
User=rerevi
Group=rerevi
WorkingDirectory=/srv/rerevi/app
EnvironmentFile=/etc/rerevi.env
ExecStart=/srv/rerevi/venv/bin/python manage.py purge_shares
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rerevi-shares /var/lib/rerevi
