[Unit]
Description=Deliver RE Revi report notifications
[Service]
Type=oneshot
User=rerevi
Group=rerevi
WorkingDirectory=/srv/rerevi/app
EnvironmentFile=/etc/rerevi.env
ExecStart=/srv/rerevi/venv/bin/python manage.py deliver_notifications
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rerevi-shares /var/lib/rerevi
