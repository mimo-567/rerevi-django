# Copy to .env, generate your own key, then load it into your process environment.
# python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REREVI_PUBLIC_ACCESS=true
REREVI_PUBLIC_BASE_URL=http://127.0.0.1:8000
REREVI_SOURCE_URL=https://github.com/mimo-567/rerevi-django
REREVI_SUPPORT_EMAIL=support@example.org
# Optional SMTP. No email is sent until configured and enabled in admin.
REREVI_SMTP_HOST=smtp.example.org
REREVI_SMTP_PORT=465
REREVI_SMTP_USERNAME=
REREVI_SMTP_FROM=support@example.org
REREVI_SMTP_OWNER=
REREVI_SMTP_SSL=true
REREVI_SMTP_TLS=false
